{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OSKA NEXUS",
  "version": "1.1.2",
  "identifier": "com.oskatech.oskanexus",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run package:backend && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OSKA NEXUS",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "transparent": false,
        "decorations": true
      },
      {
        "label": "floating",
        "title": "OSKA NEXUS Overlay",
        "url": "/index.html?overlay=true",
        "width": 440,
        "height": 260,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "compression": "zlib",
        "installMode": "currentUser"
      }
    },
    "resources": {
      "../build/backend/oska-backend/": "backend/"
    }
  }
}
